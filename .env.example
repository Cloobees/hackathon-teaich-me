# Set to 1 to test Slack wiring without Anthropic/Context Builder credentials
ECHO_MODE=

# Anthropic (API key auth; claude.ai login is not available to third-party apps)
ANTHROPIC_API_KEY=
# Company Azure APIM gateway (use instead of ANTHROPIC_API_KEY; needs `az login`)
GATEWAY_BASE_URL=
AZURE_TENANT_ID=

# Optional, defaults to claude-opus-5-5
MODEL=

# Slack app (Socket Mode): bot token (xoxb-...) and app-level token (xapp-...)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Context Builder MCP (remote, streamable HTTP)
CONTEXT_BUILDER_URL=
CONTEXT_BUILDER_TOKEN=

# Toolchain Copilot (names only; put real values in .env, never in this file)
# Comma-separated Slack user ids allowed to run /onboard @member (the four active sandbox users)
OPERATOR_USER_IDS=
# Optional: SQLite file (default state/copilot.db), library folder (default library), dashboard port (default 3000)
DB_PATH=
LIBRARY_DIR=
DASHBOARD_PORT=
# Optional: link to the glossary canvas, shown in the welcome and completion messages
GLOSSARY_CANVAS_URL=

# Public test channel where Claude Tag and the app both sit; SP-1 and the check prompts post here (BP-045, BP-047)
CHECK_CHANNEL_ID=
# Help channel name (also the I7 channel); items.yaml may override
AI_CHANNEL_NAME=
# Path of the copilot-check zip the app sends (default library-files/copilot-check.zip)
SKILL_ZIP_PATH=
# Set to 1 to let a member paste a report block if the Claude Tag route fails (BP-052)
REPORT_PASTE_FALLBACK=

# How Assist reaches Claude: claude-code = your signed-in Claude Code session (no key, no gateway; local use only).
# Leave blank to use GATEWAY_BASE_URL, or ANTHROPIC_API_KEY when that is blank.
CLAUDE_AUTH=
