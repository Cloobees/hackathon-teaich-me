# Set to 1 to test Slack wiring without Anthropic/Context Builder credentials
ECHO_MODE=

# Anthropic (API key auth; claude.ai login is not available to third-party apps)
ANTHROPIC_API_KEY=
# Company Azure APIM gateway (use instead of ANTHROPIC_API_KEY; needs `az login`)
GATEWAY_BASE_URL=
AZURE_TENANT_ID=

# Optional, defaults to claude-opus-5-5
MODEL=

# Slack app (Socket Mode): bot token (xoxb-...) and app-level token (xapp-...)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Context Builder MCP (remote, streamable HTTP)
CONTEXT_BUILDER_URL=
CONTEXT_BUILDER_TOKEN=
